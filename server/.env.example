# Copy this file to server/.env and adjust as needed.

# Port the Express API listens on.
PORT=4000
# Comma-separated list of allowed frontend origins for CORS, e.g.
#   CORS_ORIGIN=https://app.example.com
# Only needed if the frontend is deployed on a DIFFERENT origin from this API
# (e.g. Vercel/Netlify frontend + Render/Railway backend). For the normal
# single-host deployment (this process also serves client/dist), leave unset —
# same-origin requests never need CORS at all. REQUIRED in production whenever
# client/dist isn't present here: the server refuses to start without it,
# since reflecting any origin back with credentials enabled would let any
# website read this API as a logged-in user.
CORS_ORIGIN=
# Where the SQLite database file lives. Leave unset to use server/data/bsfdm.sqlite3.
# Set this to a path on a mounted persistent volume when deploying to a host
# with an ephemeral filesystem (Render, Railway, Fly.io, Heroku, etc.) — the
# server refuses to start in production on those platforms without it.
DB_PATH=
# Directory automated daily backups (see server/backup.js) are written to.
# Leave unset to use a "backups" folder next to the database file — make sure
# that also lives on persistent storage, or it's wiped along with everything
# else. How many days of backups to keep (default 14):
BACKUP_DIR=
BACKUP_RETENTION_COUNT=

# Secret used to sign login session tokens (JWT). REQUIRED before a real
# deployment — the server refuses to start in production without it. Generate
# one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Cookie SameSite policy for the session cookie. Leave unset ("lax") for the
# normal single-origin deployment (see README). Set to "none" only if the
# frontend and backend are on two different domains — this also requires HTTPS.
COOKIE_SAME_SITE=

# Base URL of the FRONTEND app, used to build the link inside password-reset
# emails (e.g. https://app.example.com — no trailing slash). Leave unset for
# local dev (defaults to http://localhost:5173) or a single-host production
# deploy (defaults to the request's own origin) — set explicitly whenever the
# frontend is deployed on a different origin from this API.
APP_URL=
# SMTP settings for sending password-reset emails — works with any provider's
# SMTP relay (Gmail, SendGrid, Mailgun, AWS SES, Postmark, etc.), no
# vendor-specific SDK needed. Without these set, the app keeps running and the
# "forgot password" flow still works internally, but the reset link is only
# logged to the server console instead of actually emailed — fine for local
# dev, not for real users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BSFDM <no-reply@example.com>
