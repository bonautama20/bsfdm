# Copy this file to client/.env and adjust as needed. Vite only exposes
# variables prefixed with VITE_ to the frontend.

# Only needed if the frontend and backend are deployed on different
# hosts/origins. Leave unset for local dev (proxied by vite.config.js) and for
# single-host deployments (the backend serves the built frontend — see
# server/index.js) — both cases use the relative "/api" path automatically.
VITE_API_BASE=
